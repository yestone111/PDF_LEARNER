{
  "name": "akn",
  "version": "1.3.6",
  "description": "DeepSeek Harness plugin: AI Knowledge Navigator — turn PDFs into a clickable knowledge graph (chapter mastery, bookmarks, annotations, notes). Runs on the host DSH model; no separate API key.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "pdf",
    "knowledge-graph",
    "pdf-reader",
    "annotation",
    "local-first"
  ],
  "author": "yestone111",
  "license": "MIT",
  "homepage": "https://github.com/yestone111/PDF_LEARNER#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yestone111/PDF_LEARNER.git"
  },
  "bugs": {
    "url": "https://github.com/yestone111/PDF_LEARNER/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "files": [
    "lib",
    "static",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "icon": "./icon.svg",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
