# ---------------------------------------------------------------------------
# AI Knowledge Navigator —— 环境变量样例
# 复制为 server/.env.local 后填入真实值；.env.local 已在 .gitignore 中。
# 前端不得读取这些变量（Vite 只暴露 VITE_ 前缀，且本项目不定义任何 VITE_ 密钥）。
# ---------------------------------------------------------------------------

# --- DeepSeek（只允许出现在 server/ 进程内） ---
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 可选覆盖，默认走官方地址
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 可选覆盖，默认 deepseek-chat
DEEPSEEK_MODEL=deepseek-chat

# --- Hono 代理 ---
# 与 web/vite.config.ts 中 /api 代理目标保持一致
PORT=8787

# 单次请求体上限（字节），超限直接返回 413，不透传上游错误
MAX_REQUEST_BYTES=2097152
